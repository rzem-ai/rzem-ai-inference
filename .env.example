# HuggingFace API Key
# Required for downloading gated models like FLUX.1-schnell
# Get your token from: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here

# Claude API Key (optional - for future features)
CLAUDE_API_KEY=sk-ant-api03-your_key_here

# Fal.ai API Key (optional - for future features)
FAL_KEY=your_fal_key_here

# Development: Skip model scanning on startup (debug builds only)
# Useful to speed up dev server restarts when you're not working on model scanning
# SKIP_SCAN_IN_DEV=1
