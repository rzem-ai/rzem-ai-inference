{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"composite": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/mainview/*"]
		}
	},
	"include": ["src/mainview/**/*.ts", "src/mainview/**/*.tsx", "src/mainview/**/*.vue", "env.d.ts"]
}
