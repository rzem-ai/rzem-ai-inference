{
  "name": "rzem-ai-inference",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "python": "./run-python.sh",
    "python:debug": "./run-python.sh --debug",
    "python:dev": "npm run build && ./run-python.sh --debug",
    "tauri": "tauri",
    "tauri:build": "npm run build && cargo build --release --manifest-path=src-tauri/Cargo.toml",
    "tauri:build:exe": "tauri build -- --no-bundle",
    "tauri:build:bundles": "tauri bundle -- --bundles app,dmg",
    "tauri:build:deb": "tauri bundle -- --bundles deb",
    "tauri:build:appimage": "tauri bundle -- --bundles appimage",
    "tauri:dev": "cross-env RUST_LOG=debug tauri dev",
    "tauri:dev1": "cross-env SKIP_SCAN_IN_DEV=1 RUST_LOG=info tauri dev",
    "tauri:dev:release": "tauri dev -- --release",
    "tauri:dev:server": "cross-env RZEM_SERVER_MODE=1 RZEM_PORT=8080 tauri dev",
    "tauri:dev:client": "cross-env RZEM_CLIENT_MODE=1 RZEM_SERVER_URL=http://10.0.0.3:8080 tauri dev"
  },
  "dependencies": {
    "@fortawesome/fontawesome-pro": "^7.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.1.0",
    "@fortawesome/pro-light-svg-icons": "^7.1.0",
    "@fortawesome/pro-regular-svg-icons": "^7.1.0",
    "@fortawesome/pro-solid-svg-icons": "^7.1.0",
    "@fortawesome/pro-thin-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@primeuix/themes": "^2.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@tiptap/vue-3": "^3.15.3",
    "@vueuse/components": "^14.1.0",
    "interactjs": "^1.10.27",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.562.0",
    "marked": "^17.0.1",
    "ogl": "^1.0.11",
    "perfect-scrollbar": "^1.5.5",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "splitpanes": "^4.0.4",
    "tailwindcss-primeui": "^0.6.1",
    "three": "^0.182.0",
    "vue": "^3.5.13",
    "vue-grid-layout": "^2.4.0",
    "vue-router": "^4.6.4",
    "vue3-perfect-scrollbar": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/splitpanes": "^2.2.6",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/devtools": "^8.0.6",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^2.1.10"
  }
}
