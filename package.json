{
  "name": "rzem-ai-inference",
  "productName": "Inference",
  "version": "0.6.0",
  "private": true,
  "main": "dist/main/index.js",
  "author": {
    "name": "RZEM AI",
    "email": "dev@rzem.ai"
  },
  "description": "Desktop AI image generation app",
  "scripts": {
    "start": "npm run build:renderer && npm run build:main && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:1978 electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:main": "tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "ai.rzem.inference",
    "productName": "Inference",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/better-sqlite3/**",
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "rzem-ai",
      "repo": "rzem-ai-inference"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fal-ai/client": "^1.9.4",
    "@primeuix/themes": "^2.0.3",
    "@tiptap/core": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@tiptap/vue-3": "^3.15.3",
    "@types/marked": "^5.0.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "better-sqlite3": "^11.0.0",
    "bonjour-service": "^1.3.0",
    "electron-updater": "^6.8.3",
    "lucide-vue-next": "^0.563.0",
    "marked": "^17.0.3",
    "ogl": "^1.0.11",
    "pinia": "^3.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "sharp": "^0.34.5",
    "tailwindcss-primeui": "^0.6.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  }
}
