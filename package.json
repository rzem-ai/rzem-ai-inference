{
  "name": "rzem-ai-inference",
  "productName": "RZEM AI Inference",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": {
    "name": "RZEM AI",
    "email": "dev@rzem.ai"
  },
  "description": "Desktop AI Image Generation",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --publish=never",
    "package:linux": "npm run build && electron-builder --linux --publish=never",
    "package:mac": "npm run build && electron-builder --mac --publish=never",
    "package:win": "npm run build && electron-builder --win --publish=never",
    "release": "npm run build && electron-builder --publish=always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fal-ai/client": "^1.9.4",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/core": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@tiptap/vue-3": "^3.15.3",
    "@types/marked": "^5.0.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.2.1",
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.6",
    "better-sqlite3": "^11.0.0",
    "bonjour-service": "^1.3.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.3",
    "lucide-vue-next": "^0.563.0",
    "marked": "^17.0.3",
    "ogl": "^1.0.11",
    "pinia": "^3.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "tailwindcss-primeui": "^0.6.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.9.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "vite": "^6.0.3",
    "vue-tsc": "^2.2.0"
  }
}
